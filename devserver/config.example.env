# Personal settings for the agentic dev server playbook (devserver/README.md).
# Copy this file to ~/.config/devserver.env on the old machine and fill it in.
# It holds no secrets and belongs in no repository. Each project keeps its own
# settings file for user/clone-repo.sh in its own repository.

# The new server
HOST_NAME=devbox        # its hostname
USER_NAME=me            # the account to create there
DEST_SSH=devbox         # SSH alias for the account on the new server (~/.ssh/config)
DEST_HOME=/home/me      # the account's home folder there

# Multi-user Nix (server/bootstrap-root.sh). The hash is the SHA-256 of
# https://releases.nixos.org/nix/nix-$NIX_VERSION/install; the installer pins
# the hash of the Nix tarball it downloads.
NIX_VERSION=2.28.3
NIX_INSTALL_SHA256=46b8d7165dceb471f4346366b3a93f1009407b99729b843b8664918f4cc800a0

# nix-home (user/bootstrap-user.sh). NIX_HOME_REV, when set, must be the
# checkout's commit.
NIX_HOME_URL=git@github.com:pwm/nix-home.git
NIX_HOME_REV=
GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"

# The checkouts whose agent history and branches move, relative to the home
# folder, separated by spaces or line breaks, each once (migrate/ and
# user/agents.sh). Paths that differ only in characters other than letters
# and digits, such as work/api-server and work/api/server, are refused.
PROJECTS="work/project"
# Where linked worktrees live inside a checkout (migrate/branches.sh)
WORKTREES_DIR=.worktrees

# The file that sets ZAI_API_KEY for LiteLLM (user/litellm-session.sh)
ZAI_KEY_FILE=/home/me/.config/litellm/env
