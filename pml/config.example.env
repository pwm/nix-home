# Settings for the PML server playbook (pml/README.md). Copy this file to
# ~/.config/pml-playbook.env on the old machine and fill it in. It holds no
# secrets and belongs in no repository.

# The new server
HOST_NAME=pml-dev       # its hostname
USER_NAME=pwm           # the account to create there
DEST_SSH=pml-dev        # SSH alias for the account on the new server (~/.ssh/config)
DEST_HOME=/home/pwm     # the account's home folder there

# Multi-user Nix (server/bootstrap-root.sh). The hash is the SHA-256 of
# https://releases.nixos.org/nix/nix-$NIX_VERSION/install; the installer pins
# the hash of the Nix tarball it downloads.
NIX_VERSION=2.28.3
NIX_INSTALL_SHA256=46b8d7165dceb471f4346366b3a93f1009407b99729b843b8664918f4cc800a0

# nix-home (user/bootstrap-user.sh). NIX_HOME_REV, when set, must be the
# checkout's commit.
NIX_HOME_URL=git@github.com:pwm/nix-home.git
NIX_HOME_REV=
GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"

# PML, relative to the home folder (user/clone-pml.sh and pml/migrate/)
PROJECT=work/pml
PML_REPO=git@github.com:artificialio/pml.git
DOCS_DIR=work/docs/pml
DOCS_REPO=git@github.com:pwm/pml-docs.git
