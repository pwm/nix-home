#! /usr/bin/env nix-shell
#! nix-shell -i bash -p coreutils curl jq
# shellcheck shell=bash
set -euo pipefail

hm_root=$(dirname "${BASH_SOURCE[0]}")/../
pushd "$hm_root" >/dev/null

function fail() {
  echo "$1" >&2
  exit 1
}

ext_dir="hm/programs/vscode"
vs_code=code
case "${1:-}" in
--code)
  [[ $# == 2 ]] || fail 'Usage: vscode-update-extensions [--code PATH]'
  vs_code=$2
  ;;
-h | --help)
  echo 'Usage: vscode-update-extensions [--code PATH]'
  echo 'Update the shared catalogue, retaining pins absent from this editor.'
  exit 0
  ;;
"") [[ $# == 0 ]] || fail 'Unexpected empty argument' ;;
*) fail 'Usage: vscode-update-extensions [--code PATH]' ;;
esac

# Keep one version per extension, with hashes for both managed machines.
# Never replace the Mac variant merely because this command ran on Linux.
platforms=(darwin-arm64 linux-x64)
work_dir=$(mktemp -d "$PWD/$ext_dir/.update-extensions.XXXXXXXX")
trap 'rm -rf "$work_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Ask the marketplace for the versions of one extension. flags=17 includes the
# version list (each entry has a targetPlatform for platform specific builds)
# and the version properties (engine requirement, pre-release flag).
function query_marketplace() {
  curl --silent --show-error --fail --request POST \
    --header 'Content-Type: application/json' \
    --header 'Accept: application/json;api-version=7.2-preview.1' \
    --data "{\"filters\":[{\"criteria\":[{\"filterType\":7,\"value\":\"$1\"}],\"pageSize\":1}],\"flags\":17}" \
    'https://marketplace.visualstudio.com/_apis/public/gallery/extensionquery'
}

# engines.vscode ranges look like ^1.107.0, >=1.80.0, ~1.60.0 or *. VSCode
# only enforces the minimum, so compare that against the installed version.
function engine_ok() {
  local min=${1#^}
  min=${min#>=}
  min=${min#~}
  min=${min// /}
  [[ -z $min || $min == '*' || $min == *x* ]] && return 0
  [[ $(printf '%s\n' "$min" "$code_ver" | sort -V | head -1) == "$min" ]]
}

# Keep the entry from the current extensions.json when the marketplace has
# nothing usable. nix can still fetch pinned versions from the binary cache as
# long as nixpkgs packages the same version.
function keep_pinned() {
  local pinned
  pinned=$(jq --compact-output --arg p "$1" --arg n "$2" '.[] | select(.publisher == $p and .name == $n)' "$ext_dir/extensions.json")
  if [[ -n $pinned ]]; then
    echo "   $3, keeping the pinned entry" >&2
    echo "$pinned"
  else
    echo "   $3 and not in extensions.json, skipping" >&2
  fi
}

function get_vsixpkg() {
  local publisher=$1 name=$2 info ver candidate engine arch hash platform_hashes url

  info=$(query_marketplace "$publisher.$name")
  if [[ $(jq '.results[0].extensions | length' <<<"$info") -eq 0 ]]; then
    keep_pinned "$publisher" "$name" "not on the marketplace any more"
    return
  fi

  # Newest version first, skipping the ones that need a newer VSCode than the
  # connected editor. Platform specific extensions list every version once per
  # platform, so deduplicate by version.
  ver=""
  arch=""
  while IFS=$'\t' read -r candidate engine; do
    if ! engine_ok "$engine"; then
      echo "   skipping $candidate, it needs VSCode $engine" >&2
      continue
    fi
    if ! jq -e --arg v "$candidate" 'any(.results[0].extensions[0].versions[]; .version == $v and (.targetPlatform // "universal") == "universal")' <<<"$info" >/dev/null; then
      # Do not advance one machine without the other. A missing platform
      # keeps us on the next compatible version, or on the existing pin.
      if ! jq -e --arg v "$candidate" '[.results[0].extensions[0].versions[] | select(.version == $v) | .targetPlatform] | contains(["darwin-arm64", "linux-x64"])' <<<"$info" >/dev/null; then
        echo "   skipping $candidate, it is missing a managed platform" >&2
        continue
      fi
      arch=platforms
    fi
    ver=$candidate
    break
  done < <(jq --raw-output '.results[0].extensions[0].versions[] | [.version, ((.properties // []) | map(select(.key == "Microsoft.VisualStudio.Code.Engine")) | .[0].value // "*")] | @tsv' <<<"$info" | awk -F'\t' '!seen[$1]++')
  if [[ -z $ver ]]; then
    keep_pinned "$publisher" "$name" "no version supports VSCode $code_ver"
    return
  fi

  url="https://$publisher.gallery.vsassets.io/_apis/public/gallery/publisher/$publisher/extension/$name/$ver/assetbyname/Microsoft.VisualStudio.Services.VSIXPackage"
  if [[ $arch == platforms ]]; then
    platform_hashes='{}'
    for arch in "${platforms[@]}"; do
      curl --silent --show-error --fail --location --request GET --output "$work_dir/extension.vsix" "$url?targetPlatform=$arch"
      hash=$(nix-hash --flat --base32 --type sha256 "$work_dir/extension.vsix")
      platform_hashes=$(jq --arg arch "$arch" --arg hash "$hash" '. + {($arch): $hash}' <<<"$platform_hashes")
    done
    jq --null-input --compact-output \
      --arg name "$name" --arg publisher "$publisher" --arg version "$ver" --argjson platforms "$platform_hashes" \
      '{ $name, $publisher, $version, $platforms }'
  else
    curl --silent --show-error --fail --location --request GET --output "$work_dir/extension.vsix" "$url"
    hash=$(nix-hash --flat --base32 --type sha256 "$work_dir/extension.vsix")
    jq --null-input --compact-output \
      --arg name "$name" --arg publisher "$publisher" --arg version "$ver" --arg sha256 "$hash" \
      '{ $name, $publisher, $version, $sha256 }'
  fi
}

echo -n "Ensuring VSCode is present ... "
command -v "$vs_code" >/dev/null || fail 'VSCode CLI not found. Run in a VSCode terminal, or use --code PATH.'
# Use the connected editor's version; this works with the remote CLI too.
code_ver=$("$vs_code" --version | head -1)
echo "found at $vs_code (version $code_ver)"

# Capture the complete list before processing. A failed CLI call must not
# produce a partial catalogue, and the server's sparse list must not erase pins.
"$vs_code" --list-extensions >"$work_dir/installed"
jq --raw-output '.[] | "\(.publisher).\(.name)"' "$ext_dir/extensions.json" >"$work_dir/pinned"
sort -u "$work_dir/pinned" "$work_dir/installed" >"$work_dir/ids"
echo "Downloading and updating extensions:"
: >"$work_dir/entries.jsonl"
while IFS= read -r i; do
  [[ -n $i ]] || continue
  # ignore updating our own extensions (they are symlinked locally)
  if [[ $i == artificialio.* ]]; then
    keep_pinned "${i%%.*}" "${i#*.}" 'local extension' >>"$work_dir/entries.jsonl"
    continue
  fi
  echo " - $i ..."
  get_vsixpkg "${i%%.*}" "${i#*.}" >>"$work_dir/entries.jsonl"
done <"$work_dir/ids"
jq --slurp 'sort_by(.name)' "$work_dir/entries.jsonl" >"$work_dir/result.json"
echo "Latest extension versions downloaded and new extensions.json constructed."

echo -n "Backing old $ext_dir/extensions.json ... "
cp "$ext_dir/extensions.json" "$ext_dir/extensions.json.niu"
echo "done, ($ext_dir/extensions.json.niu)."

echo -n "Writing result to $ext_dir/extensions.json ... "
mv "$work_dir/result.json" "$ext_dir/extensions.json"
echo "done."

popd >/dev/null
