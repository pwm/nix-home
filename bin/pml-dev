#!/usr/bin/env bash
# Work on the remote PML workstation from the Mac.
# Needs the `pml-dev` host alias in ~/.ssh/config (user pwm, the server address).
#
#   pml-dev                      attach to the remote Zellij session `pml`, creating it if needed
#   pml-dev attach [SESSION]     the same, for another session name
#   pml-dev forward PORT         show remote 127.0.0.1:PORT at local 127.0.0.1:PORT (Ctrl-C stops)
#   pml-dev put LOCAL [REMOTE]   copy a local file or directory to the server (default: ~/)
#   pml-dev get REMOTE [LOCAL]   copy a server file or directory to the Mac (default: .)
#   pml-dev shot [FILE]          copy FILE (default: the newest Desktop screenshot) to the server's
#                                ~/shots and put its server path on the clipboard, for an agent prompt
#
# Detaching or losing the connection leaves the remote session and its work running.
# Development services stay bound to loopback on the server; forwarding the same
# port number keeps the application's origin unchanged.
# Another server: DEVSERVER_HOST names its alias, DEVSERVER_SESSION the default session.
set -euo pipefail

host=${DEVSERVER_HOST:-pml-dev}
default_session=${DEVSERVER_SESSION:-pml}
# ssh would read a leading '-' as an option.
if [[ $host == -* ]]; then
  echo "DEVSERVER_HOST must name an SSH host alias." >&2
  exit 1
fi

usage() {
  sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
}

# A session name must reach Zellij as a name: a leading '-' would be read as an
# option (`-f` forces old pane commands to run on resurrection) and `attach`'s own
# subcommands (`options`, `help`) as commands.
valid_session() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] && [[ $1 != options && $1 != help ]]
}

attach() {
  local session=${1:-$default_session}
  if ! valid_session "$session"; then
    echo "Session names start with a letter or digit, use letters, digits, '-' and '_' only, and are not 'options' or 'help'." >&2
    exit 1
  fi
  # A login Fish loads the Nix profile and SHELL=fish, so new panes open Fish.
  exec ssh -t "$host" "exec ~/.nix-profile/bin/fish -l -c 'exec zellij attach -c $session'"
}

forward() {
  local port=$1
  # Plain decimal only: no leading zero (read as octal) and no oversized number.
  if [[ ! $port =~ ^[1-9][0-9]{3,4}$ ]] || ((10#$port < 1024 || 10#$port > 65535)); then
    echo "Give an unprivileged port number (1024-65535)." >&2
    exit 1
  fi
  echo "Forwarding 127.0.0.1:$port to $host 127.0.0.1:$port. Ctrl-C stops."
  exec ssh -N -o ExitOnForwardFailure=yes -L "127.0.0.1:$port:127.0.0.1:$port" "$host"
}

# An agent on the server cannot read a Mac path, such as a file dropped on the terminal.
shot() {
  local file name path candidate
  if (($# == 0)); then
    file=
    for candidate in "$HOME"/Desktop/Screenshot\ *; do
      if [[ -f $candidate && (-z $file || $candidate -nt $file) ]]; then
        file=$candidate
      fi
    done
    if [[ -z $file ]]; then
      echo "No screenshot on the Desktop." >&2
      exit 1
    fi
  else
    file=$1
    if [[ ! -f $file ]]; then
      echo "Not a file: $file" >&2
      exit 1
    fi
  fi
  # Only letters, digits, '.', '_' and '-' reach the remote shell.
  name=$(printf '%s' "${file##*/}" | LC_ALL=C tr -cs 'A-Za-z0-9._-' '-')
  # shellcheck disable=SC2029 # $name expands here, on purpose
  path=$(ssh "$host" "mkdir -p shots && cat > shots/$name && echo \"\$HOME/shots/$name\"" <"$file")
  if [[ $path != /*"/shots/$name" ]]; then
    echo "Unexpected reply from $host: $path" >&2
    exit 1
  fi
  printf '%s' "$path" | pbcopy
  echo "$path is on the clipboard."
}

refuse() {
  usage >&2
  exit 1
}

case ${1:-attach} in
attach)
  shift || true
  (($# <= 1)) || refuse
  attach "$@"
  ;;
forward)
  shift
  (($# == 1)) || refuse
  forward "$1"
  ;;
put)
  shift
  (($# >= 1 && $# <= 2)) || refuse
  exec scp -r -- "$1" "$host:${2:-}"
  ;;
get)
  shift
  (($# >= 1 && $# <= 2)) || refuse
  exec scp -r -- "$host:$1" "${2:-.}"
  ;;
shot)
  shift
  (($# <= 1)) || refuse
  shot "$@"
  ;;
-h | --help | help)
  usage
  ;;
*)
  refuse
  ;;
esac
